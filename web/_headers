# Response headers for get.mthani.app on Cloudflare Pages (specs/008 contracts/hosting.md).
# tool/web_deploy.mjs fills in the placeholder in script-src with the SHA-256 of index.html's script.
# No Cross-Origin-Opener-Policy or Cross-Origin-Embedder-Policy: with them, recordings from the
# recitation hosts would stop loading (research R2).
# Usage statistics (specs/016 research R8): the Firebase JS SDK from gstatic, gtag from
# googletagmanager, and the analytics, installations and config hosts.
# Microsoft Clarity: its tag from www.clarity.ms and scripts.clarity.ms; it sends to *.clarity.ms
# and c.bing.com.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' __INLINE_SCRIPT_HASHES__ https://www.gstatic.com https://www.googletagmanager.com https://*.clarity.ms; worker-src 'self' blob:; connect-src 'self' blob: https://everyayah.com https://mirrors.quranicaudio.com https://download.quranicaudio.com https://audio-cdn.tarteel.ai https://huggingface.co https://*.hf.co https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://firebaseinstallations.googleapis.com https://firebase.googleapis.com https://*.clarity.ms https://c.bing.com; media-src 'self' blob:; img-src 'self' data: blob: https://*.clarity.ms https://c.bing.com; font-src 'self' data:; style-src 'self' 'unsafe-inline'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: microphone=(self), camera=(), geolocation=(self)

# Checked on every visit; the service worker keeps them per build (research R9).
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache
/asset-hashes.json
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
/flutter_bootstrap.js
  Cache-Control: no-cache
/main.dart.*
  Cache-Control: no-cache
/canvaskit/*
  Cache-Control: no-cache
/sqflite_sw.js
  Cache-Control: no-cache
/speech/*
  Cache-Control: no-cache
/editor/*
  Cache-Control: no-cache

/*.wasm
  Content-Type: application/wasm
/sqlite3.wasm
  Cache-Control: no-cache

# A page font never changes under its name (a new font is a new name).
/assets/assets/qcf/*
  Cache-Control: public, max-age=31536000, immutable

# Group khatma links (specs/014 research R16): the app's page for /k/<code>, always fresh, and
# the two files that let the installed apps open them.
/k/*
  Cache-Control: no-cache
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: max-age=3600
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: max-age=3600
