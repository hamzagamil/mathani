<?xml version="1.0" encoding="utf-8"?>
<!-- Quran widget (specs/017): 2×2 to 4×2, home screen and lock screen. It changes only when the app
     sends a new snapshot. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_quran_description"
    android:initialLayout="@layout/widget_message"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="330dp"
    android:maxResizeHeight="220dp"
    android:previewLayout="@layout/widget_quran_small"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen|keyguard"/>
